# Vantage — copy to `.env` (do not commit `.env`)
#
# Docker Compose (default in README):
#   `compose.yaml` sets DATA_DIR and DATABASE_URL to /app/data inside the backend
#   container. Your files appear on the host in ./data (volume ./data:/app/data).
#   Keep OLLAMA_* on host.docker.internal so the container can reach Ollama on the Mac.
#
# Local backend only (uvicorn from backend/, no Docker):
#   DATA_DIR=../data
#   DATABASE_URL=sqlite:///../data/vantage.db
#   OLLAMA_BASE_URL=http://localhost:11434/v1
#   OLLAMA_HOST=http://localhost:11434

APP_ENV=development
LOG_LEVEL=INFO

# Host-oriented paths (project root ./data). Ignored for data paths when using Docker Compose.
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/vantage.db

# Ollama on the host — use localhost values when running the backend outside Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_HOST=http://host.docker.internal:11434

DEFAULT_CONTEXT_TOKENS=8192
CHAT_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=52428800
PROCESSING_TIMEOUT_SECONDS=600

# When reference docs exceed the model context: max FTS hits and fallback chunks per ref.
FTS_CHUNK_LIMIT=24
FTS_MIN_QUERY_CHARS=2
FTS_FALLBACK_PER_DOCUMENT=4

# Web / DokuWiki snapshot sources
WEB_MAX_PAGES=200
WEB_FETCH_TIMEOUT=30
WEB_REFRESH_INTERVAL_HOURS=24

# Docker Compose: only the web UI is published on localhost (default 7847). API stays internal.
HOST_WEB_PORT=7847
VITE_DEV_PORT=7847

# Image / app version (semver). Bump package.json + pyproject.toml together when releasing.
# IMAGE_TAG=0.1.0
# Optional build id for support (short SHA). Example when building:
#   GIT_SHA=$(git rev-parse --short HEAD) docker compose up --build
# GIT_SHA=

# Browser API calls: leave empty to use same-origin /api via Vite proxy (recommended).
# Local backend without proxy: http://127.0.0.1:8000
VITE_API_BASE_URL=

# Set in compose for the frontend container only; do not set on the host for normal use.
# VITE_PROXY_TARGET=http://backend:8000

# Optional: comma-separated CORS origins for the API (compose sets this from HOST_WEB_PORT).
# CORS_ORIGINS=http://127.0.0.1:7847,http://localhost:7847
