# Review Assistant — copy to `.env` (do not commit `.env`)
#
# Docker Compose (default in README):
#   `compose.yaml` sets DATA_DIR and DATABASE_URL to /app/data inside the backend
#   container. Your files appear on the host in ./data (volume ./data:/app/data).
#   Keep OLLAMA_* on host.docker.internal so the container can reach Ollama on the Mac.
#
# Local backend only (uvicorn from backend/, no Docker):
#   DATA_DIR=../data
#   DATABASE_URL=sqlite:///../data/review_assistant.db
#   OLLAMA_BASE_URL=http://localhost:11434/v1
#   OLLAMA_HOST=http://localhost:11434

APP_ENV=development
LOG_LEVEL=INFO

# Host-oriented paths (project root ./data). Ignored for data paths when using Docker Compose.
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/review_assistant.db

# Ollama on the host — use localhost values when running the backend outside Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_HOST=http://host.docker.internal:11434

DEFAULT_CONTEXT_TOKENS=8192
CHAT_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=52428800
PROCESSING_TIMEOUT_SECONDS=600

# Frontend: leave empty when using Vite dev server (proxy to backend in vite.config.ts).
# Set to http://127.0.0.1:8000 if the browser must call the API directly.
VITE_API_BASE_URL=
